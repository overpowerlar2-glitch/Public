# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tabiya
# Public base URL, used in invitation and password-reset links
APP_URL=http://localhost:3000
PORT=3000
# Optional: SMTP URL for password-reset email (e.g. smtps://user:pass@smtp.example.com).
# Without it, reset links are printed to the server log instead of being emailed.
SMTP_URL=
MAIL_FROM="Tabiya <no-reply@example.com>"
# Optional: native Stockfish (build with scripts/build-stockfish.sh). Without it the browser engine is used.
STOCKFISH_PATH=
STOCKFISH_POOL=
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64
# Optional: private site. Only verified addresses at these domains can sign up and sign in; guests are refused.
# Requires SMTP_URL in production so confirmation emails can be delivered.
ALLOWED_EMAIL_DOMAINS=
